      m_Calls: []
  m_text: "<line-height=100%><color=#00D084><b><size=130%>09.</size> What was the
    real \u201CSomething Old\u201D in Lily\u2019s bouquet?</b></color>\n\n<line-height=130%><indent=5%><size=95%>\n<color=#47EBB3>A.</color>
    A cheap lace dyed with strong coffee.\n<color=#47EBB3>B.</color> A secret that
    smelled like latte for five years.\n<color=#47EBB3>C.</color> A new memory pretending
    to be an old one.</size></indent></line-height>"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 2e498d1c8094910479dc3e1b768306a4, type: 2}
