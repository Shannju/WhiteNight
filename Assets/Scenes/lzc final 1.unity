  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: '<line-height=100%><color=#FF66B2><b><size=130%>10.</size> Is a failed
    hobby still a hobby?</b></color>


    <line-height=130%><indent=5%><size=95%>

    <color=#FF94C9>A.</color>
    Yes, if it leaves knowledge behind.

    <color=#FF94C9>B.</color> No, because
    dead plants cannot sign the homework.

    <color=#FF94C9>C.</color> It depends
    on whether it is useful.</size></indent></line-height>'
  m_isRightToLeft: 0
