  m_text: '<line-height=100%><color=#00D084><b><size=130%>04.</size> Why was the
    flight attendant surprised?</b></color>


    <line-height=130%><indent=5%><size=95%>

    <color=#47EBB3>A.</color>
    Because politeness is not always the same as understanding.

    <color=#47EBB3>B.</color>
    Because a person may cross borders and still not know which page they are on.

    <color=#47EBB3>C.</color>
    Because the traveller used two languages, but neither was Italian.</size></indent></line-height>'
  m_isRightToLeft: 0
