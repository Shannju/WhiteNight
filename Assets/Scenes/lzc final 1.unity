      m_Calls: []
  m_text: "<line-height=100%><color=#FF66B2><b><size=130%>05.</size> Why couldn\u2019t
    Linda buy apple pie even though she arrived before six?</b></color>\n\n<line-height=130%><indent=5%><size=95%>\n<color=#FF94C9>A.</color>
    Because the shop closed at one o\u2019clock because of the holiday.\n<color=#FF94C9>B.</color>
    Because some things are not about not trying hard enough, but about finally having
    time only after everything has closed.\n<color=#FF94C9>C.</color> Because reading
    comprehension will not open the door for someone who is five minutes late.</size></indent></line-height>"
