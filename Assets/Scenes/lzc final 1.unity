  m_text: '<line-height=100%><color=#3399FF><b><size=130%>11.</size> Why did Henry
    miss the film he had looked forward to?</b></color>


    <line-height=130%><indent=5%><size=95%>

    <color=#7ABFFF>A.</color>
    Because things do not always go as people plan.

    <color=#7ABFFF>B.</color>
    Because he was too tired and fell asleep.

    <color=#7ABFFF>C.</color> Because
    a perfect Sunday may still contain a missed film.</size></indent></line-height>'
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 2e498d1c8094910479dc3e1b768306a4, type: 2}
