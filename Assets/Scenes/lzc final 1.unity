      m_Calls: []
  m_text: '<line-height=100%><color=#00C4CC><b><size=130%>02.</size> Why couldn''t
    the Italian tourist sleep after taking his photo?</b></color>


    <line-height=130%><indent=5%><size=95%>

    <color=#5EE2E8>A.</color>
    Because he had forgotten to close the heavy curtains.

    <color=#5EE2E8>B.</color>
    Because the sun was working overtime.

    <color=#5EE2E8>C.</color> Because
    after waiting all day for light, he suddenly wanted darkness.</size></indent></line-height>'
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 2e498d1c8094910479dc3e1b768306a4, type: 2}
